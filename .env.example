# Personal local mode (recommended for macOS)
# `npm run local:setup` creates these values in .env.local automatically.
WORKLIFE_LOCAL_MODE=false
# Use pglite:./data/morrow for a fully local database, or a Postgres URL.
DATABASE_URL=
WORKLIFE_APP_URL=http://localhost:3000
# At least 32 random characters (for example: openssl rand -base64 32)
WORKLIFE_SESSION_SECRET=
# Exactly 32 bytes encoded as base64, or 64 hexadecimal characters
CONNECTOR_ENCRYPTION_KEY=
CONNECTOR_ENCRYPTION_KEY_VERSION=local-v1
# OAuth routes are development/local-only until production identity, tenant
# isolation, KMS, webhook, and deletion gates are implemented.
WORKLIFE_ENABLE_CONNECTOR_AUTHORIZATION=false

# Google OAuth app (register Gmail, Calendar, and Drive callback URLs)
WORKLIFE_GOOGLE_CLIENT_ID=
WORKLIFE_GOOGLE_CLIENT_SECRET=
# Personal test accounts can use local_testing. Public apps need approved.
WORKLIFE_GMAIL_VERIFICATION_STATUS=pending
# Optional least-privilege scope overrides (space or comma separated)
# WORKLIFE_GMAIL_SCOPES=
# WORKLIFE_CALENDAR_SCOPES=
# WORKLIFE_DRIVE_SCOPES=

# Slack OAuth app
WORKLIFE_SLACK_CLIENT_ID=
WORKLIFE_SLACK_CLIENT_SECRET=
# Optional until signed Slack event ingestion is enabled.
WORKLIFE_SLACK_SIGNING_SECRET=
# Optional selected-channel bot-scope override
# WORKLIFE_SLACK_BOT_SCOPES=channels:read,channels:history,groups:read,groups:history,users:read

# Notion public integration
WORKLIFE_NOTION_CLIENT_ID=
WORKLIFE_NOTION_CLIENT_SECRET=
# Optional until signed Notion event ingestion is enabled.
WORKLIFE_NOTION_WEBHOOK_SECRET=
WORKLIFE_NOTION_VERSION=

# Hosted durable-worker handoff. Personal local mode uses authenticated polling
# in the local Next.js process and does not need these values.
WORKLIFE_SYNC_DISPATCH_URL=
WORKLIFE_SYNC_SIGNING_SECRET=

# Authorization and token endpoints also have optional provider-specific
# overrides. Leave them unset for standard Google, Slack, and Notion endpoints.
